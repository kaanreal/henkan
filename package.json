{
  "name": "henkan",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:updater": "node --test scripts/generate-updater-manifest.test.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --package henkan --bin henkan-cli",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:skin-template": "node scripts/build-osu-skin-template.mjs",
    "build:logo": "node scripts/build-logo.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:packages": "node scripts/audit-packages.mjs",
    "sync:packages": "node scripts/sync-package-metadata.mjs"
  },
  "dependencies": {
    "@aptabase/tauri": "^0.4.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "fast-png": "^8.0.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.2.0",
    "utif": "^3.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/utif": "^3.0.6",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.0"
  }
}
