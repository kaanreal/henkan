{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Henkan",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-text-file",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "ffmpeg", "sidecar": true }]
    },
    "aptabase:allow-track-event",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
