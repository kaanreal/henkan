{
  "packages": {
    ".": {
      "release-type": "simple",
      "include-v-in-tag": true,
      "pull-request-title-pattern": "chore: release ${version}",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "package.json",
        "src-tauri/tauri.conf.json",
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        "src/wasm/package.json"
      ]
    }
  }
}
