# Maintainer: kaanreal <kaanreal@users.noreply.github.com>

pkgname=henkan-bin
pkgver=1.8.0
pkgrel=1
pkgdesc='osu!mania to Etterna and StepMania converter (desktop and CLI)'
arch=('x86_64')
url='https://github.com/kaanreal/henkan'
license=('MIT')
provides=('henkan')
conflicts=('henkan')
options=('!strip')
source=(
  "Henkan-${pkgver}.AppImage::${url}/releases/download/v${pkgver}/Henkan-v${pkgver}-linux.AppImage"
  'LICENSE'
)
sha256sums=(
  '238b5d804d3f4808231ab7015dd8afa050ebbd78e10bbd1f84b5a8e3537e7970'
  'ccaccd972ac49ea3ce4f6ca62056b2532631839bf5c92b6c2adc797d597de78b'
)

prepare() {
  chmod +x "Henkan-${pkgver}.AppImage"
  "./Henkan-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/henkan" "$pkgdir/usr/bin"
  cp -a squashfs-root/. "$pkgdir/opt/henkan/"

  ln -s /opt/henkan/AppRun "$pkgdir/usr/bin/henkan"
  ln -s /opt/henkan/usr/bin/henkan-cli "$pkgdir/usr/bin/henkan-cli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 squashfs-root/usr/share/applications/Henkan.desktop \
    "$pkgdir/usr/share/applications/henkan.desktop"
  sed -i 's/^Exec=.*/Exec=henkan/' "$pkgdir/usr/share/applications/henkan.desktop"

  for icon in squashfs-root/usr/share/icons/hicolor/*/apps/henkan.png; do
    destination="${icon#squashfs-root/}"
    install -Dm644 "$icon" "$pkgdir/$destination"
  done
}
